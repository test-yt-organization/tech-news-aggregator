# Anthropic API（要約・ジャンル分類）
ANTHROPIC_API_KEY=

# GitHub Personal Access Token（GitHub MCP 用）
GITHUB_PERSONAL_ACCESS_TOKEN=

# Supabase / PostgreSQL
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# アプリケーション設定
APP_ENV=development
LOG_LEVEL=INFO

# 記事保持期間（日数。デフォルト 30）
ARTICLE_RETENTION_DAYS=30

# YouTube RSS / Qiita / Zenn の収集設定（カンマ区切り）
RSS_FEED_URLS=
QIITA_TAGS=
ZENN_TOPICS=
YOUTUBE_CHANNEL_IDS=
